+// Focus has come back, so the pointer resumes where it was rather than waiting
+// out the movement gate again, and this frame carries no host buttons at all:
+// whatever the runtime left in its action state is not a press the user could
+// see. Whether the frame should be handed straight back with nothing in it, so
+// the release reaches Java even when the loss and the gain arrived in the same
+// pollEvents batch and there was no unfocused frame to release on.
+//
+// The flag is only spent once the session really is focused, so a resume
+// noticed while focus is elsewhere stays pending rather than being thrown away.
+// pointerOn and handsLocked are the user's own choices and are not touched here.
+static int applyPendingInputResume(XrCtx* ctx) {
+    if (!ctx->inputResumePending || ctx->sessionState != XR_SESSION_STATE_FOCUSED) {
+        return 0;
+    }
+    ctx->inputResumePending = 0;
+    resetInputState(ctx);
+    ctx->pointerAwake = 1;
+    ctx->stillFor = 0.0f;
+    ctx->movingFor = 0.0f;
+    ctx->beamVisible = 0;
+    return 1;
 }
 
