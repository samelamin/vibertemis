<?xml version="1.0" encoding="utf-8"?>
<!--
  Secondary action drawable for the Updates screen (Cancel, Back).
  Raised card tint with a subtle border, white text, and the same
  teal focus ring as the primary action so focus traversal looks
  uniform across the screen.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/upd_panel_focus_ring" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/upd_panel_secondary_bg" />
                    <stroke android:width="1dp" android:color="@color/upd_panel_secondary_border" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/upd_panel_secondary_border" />
            <stroke android:width="1dp" android:color="@color/upd_panel_secondary_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/upd_panel_secondary_bg" />
            <stroke android:width="1dp" android:color="@color/upd_panel_secondary_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>