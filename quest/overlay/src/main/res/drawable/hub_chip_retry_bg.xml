<?xml version="1.0" encoding="utf-8"?>
<!--
  Inline retry chip. Used inside the connection card when an error
  appears. Subtle teal outline so it never competes with the primary
  Connect button. Pressed/focused states deepen the fill so the
  ray-cast focus ring stays visible.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/hub_panel_accent_pressed" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/hub_panel_focus" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/hub_panel_accent" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/hub_panel_focus" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/hub_panel_focus" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>