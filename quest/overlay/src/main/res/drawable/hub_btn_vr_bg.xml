<?xml version="1.0" encoding="utf-8"?>
<!-- Full VR start button: warm outline on a dark ember fill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hub_vr_fill_pressed" />
            <stroke android:width="2dp" android:color="@color/hub_vr_tint" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hub_vr_fill_pressed" />
            <stroke android:width="3dp" android:color="@color/hub_panel_fg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hub_vr_fill_pressed" />
            <stroke android:width="3dp" android:color="@color/hub_panel_fg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hub_vr_fill" />
            <stroke android:width="1dp" android:color="@color/hub_vr_tint" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
