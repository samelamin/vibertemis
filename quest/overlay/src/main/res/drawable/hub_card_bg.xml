<?xml version="1.0" encoding="utf-8"?>
<!--
  Connection card background. Rounded 14dp corners, dark ink fill,
  subtle 1dp stroke for separation against the hub background.
  Matches the Claude frontend-design palette tokens:
    card    #141B21 (hub_panel_card)
    stroke  #1F2A33 (hub_panel_card_stroke)
  Background is drawn before the stroke so the stroke never bleeds
  into the rounded corners.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/hub_panel_card" />
    <stroke
        android:width="1dp"
        android:color="@color/hub_panel_card_stroke" />
    <corners android:radius="14dp" />
</shape>