<?xml version="1.0" encoding="utf-8"?>
<!--
  Secondary 56dp button. Transparent fill, subtle 1dp stroke so it
  reads as a sibling to the primary card but stays subordinate.
  Pressed/focused states tint the fill lightly so the focus ring is
  visible on a headset without painting a "selected" look.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/hub_panel_card_stroke" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/hub_panel_focus" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/hub_panel_card" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/hub_panel_focus" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/hub_panel_card_stroke" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>