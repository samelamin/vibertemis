--- /dev/null
+++ b/alvr/server_openvr/cpp/alvr_server/shader/RgbToYuvPlanar.hlsl
@@ -0,0 +1,51 @@
+// Planar BT.709 conversion; adapted from Galaxy XR ALVR Research (MIT).
+cbuffer YuvPlanarParams {
+	float4 offset; // .x = Y offset, .y = Cb offset, .z = Cr offset
+	float4 yCoeff;
+	float4 uCoeff;
+	float4 vCoeff;
+
+	uint srgbEncode; // 1 when the source SRV decodes sRGB for us, so we must re-encode
+	uint _padding0;
+	uint _padding1;
+	uint _padding2;
+};
+
+Texture2D<float4> sourceTexture;
+
+SamplerState pointSampler {
+	// 4:4:4 is a 1:1 mapping, so there is nothing to filter.
+	Filter = MIN_MAG_MIP_POINT;
+	AddressU = CLAMP;
+	AddressV = CLAMP;
+};
+
+struct PS_OUTPUT {
+	float plane_Y : SV_Target0;
+	float plane_Cb : SV_Target1;
+	float plane_Cr : SV_Target2;
+};
+
+// The composition texture is _UNORM_SRGB and is not TYPELESS, so a non-sRGB view of it cannot be
+// created; sampling therefore returns linear light. YCbCr coefficients expect gamma-encoded RGB,
+// so undo the hardware's sRGB decode. Exact at 8-bit: the intermediate is float32.
+float3 LinearToSrgb(float3 c) {
+	c = saturate(c);
+	float3 lo = c * 12.92;
+	float3 hi = 1.055 * pow(max(c, 1e-8), 1.0 / 2.4) - 0.055;
+	// Component-wise select without HLSL 2021's select().
+	return lerp(lo, hi, step(0.0031308, c));
+}
+
+PS_OUTPUT main(float2 uv : TEXCOORD0) {
+	float3 rgb = sourceTexture.Sample(pointSampler, uv).rgb;
+	if (srgbEncode != 0) {
+		rgb = LinearToSrgb(rgb);
+	}
+
+	PS_OUTPUT output;
+	output.plane_Y = dot(rgb, yCoeff.rgb) + offset.x;
+	output.plane_Cb = dot(rgb, uCoeff.rgb) + offset.y;
+	output.plane_Cr = dot(rgb, vCoeff.rgb) + offset.z;
+	return output;
+}
