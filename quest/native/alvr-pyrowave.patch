diff --git a/alvr/server_core/src/pcvr_codec.rs b/alvr/server_core/src/pcvr_codec.rs
new file mode 100644
index 0000000..1c39dab
--- /dev/null
+++ b/alvr/server_core/src/pcvr_codec.rs
@@ -0,0 +1,116 @@
+//! Per-connection choice. Saved dashboard preferences remain owned by ALVR.
+use alvr_packets::PcvrRequest;
+use alvr_session::CodecType;
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    OnceLock,
+};
+static PROBE: OnceLock<fn() -> bool> = OnceLock::new();
+static FAILED: AtomicBool = AtomicBool::new(false);
+pub fn set_encoder_probe(probe: fn() -> bool) {
+    let _ = PROBE.set(probe);
+}
+pub fn failed() -> bool {
+    FAILED.load(Ordering::Acquire)
+}
+pub fn report_failure() {
+    FAILED.store(true, Ordering::Release);
+}
+pub fn encoder_available() -> bool {
+    !failed() && PROBE.get().is_some_and(|probe| probe())
+}
+
+pub fn select(
+    request: &PcvrRequest,
+    preferred: CodecType,
+    av1: bool,
+    decoder_pyro: bool,
+    encoder_pyro: bool,
+) -> CodecType {
+    let standard = |codec| match codec {
+        CodecType::PyroWave => {
+            if av1 {
+                CodecType::AV1
+            } else {
+                CodecType::Hevc
+            }
+        }
+        CodecType::AV1 if !av1 => CodecType::Hevc,
+        other => other,
+    };
+    let fallback = standard(request.fallback.unwrap_or(preferred));
+    let requested = if request.travel {
+        fallback
+    } else {
+        request.codec.unwrap_or(preferred)
+    };
+    match requested {
+        CodecType::PyroWave if decoder_pyro && encoder_pyro => CodecType::PyroWave,
+        CodecType::PyroWave => fallback,
+        codec => standard(codec),
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn intersects_caps_and_preserves_standard_fallback() {
+        let mut request = PcvrRequest {
+            codec: Some(CodecType::PyroWave),
+            fallback: Some(CodecType::Hevc),
+            ..Default::default()
+        };
+        assert_eq!(
+            select(&request, CodecType::AV1, true, true, true),
+            CodecType::PyroWave
+        );
+        for (decoder, encoder) in [(false, true), (true, false), (false, false)] {
+            assert_eq!(
+                select(&request, CodecType::AV1, true, decoder, encoder),
+                CodecType::Hevc
+            );
+        }
+        request.travel = true;
+        assert_eq!(
+            select(&request, CodecType::AV1, true, true, true),
+            CodecType::Hevc
+        );
+        request.fallback = Some(CodecType::AV1);
+        assert_eq!(
+            select(&request, CodecType::AV1, false, true, true),
+            CodecType::Hevc
+        );
+        assert_eq!(
+            select(&PcvrRequest::default(), CodecType::H264, true, true, true),
+            CodecType::H264
+        );
+    }
+}
+
+pub fn bitrate_config(
+    base: &alvr_session::BitrateConfig,
+    ceiling: Option<u64>,
+) -> alvr_session::BitrateConfig {
+    let mut config = base.clone();
+    if let Some(ceiling) = ceiling {
+        config.mode = alvr_session::BitrateMode::Adaptive {
+            saturation_multiplier: 0.9,
+            max_throughput_mbps: alvr_common::settings_schema::Switch::Enabled(ceiling),
+            min_throughput_mbps: alvr_common::settings_schema::Switch::Disabled,
+            max_network_latency_ms: alvr_common::settings_schema::Switch::Disabled,
+            encoder_latency_limiter: alvr_common::settings_schema::Switch::Enabled(
+                alvr_session::EncoderLatencyLimiter {
+                    max_saturation_multiplier: 0.9,
+                },
+            ),
+            decoder_latency_limiter: alvr_common::settings_schema::Switch::Enabled(
+                alvr_session::DecoderLatencyLimiter {
+                    max_decoder_latency_ms: 15,
+                    latency_overstep_frames: 30,
+                    latency_overstep_multiplier: 0.9,
+                },
+            ),
+        };
+    }
+    config
+}
