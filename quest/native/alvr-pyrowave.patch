+        );
+        assert_eq!(
+            valid_velocity(
+                SpaceVelocityFlags::ANGULAR_VALID,
+                SpaceVelocityFlags::ANGULAR_VALID,
+                Vec3::new(0.0, f32::INFINITY, 0.0)
+            ),
+            Vec3::ZERO
+        );
+    }
+
+    #[test]
+    fn pose_validation_rejects_garbage() {
+        assert!(validated_pose(Pose {
+            position: Vec3::new(f32::NAN, 0.0, 0.0),
+            orientation: Quat::IDENTITY,
+        })
+        .is_none());
+        // a zero-length quaternion cannot be normalized into a rotation
+        assert!(normalized_quat(Quat::from_xyzw(0.0, 0.0, 0.0, 0.0)).is_none());
+        assert!(normalized_quat(Quat::from_xyzw(f32::NAN, 0.0, 0.0, 1.0)).is_none());
+    }
+
+    #[test]
+    fn pose_validation_normalizes_rotation() {
+        let pose = validated_pose(Pose {
+            position: Vec3::new(0.1, 0.2, 0.3),
+            orientation: Quat::from_xyzw(2.0, 0.0, 0.0, 2.0),
+        })
+        .unwrap();
+
+        assert!((pose.orientation.length() - 1.0).abs() < 1e-5);
+        assert_eq!(pose.position, Vec3::new(0.1, 0.2, 0.3));
+    }
+
+    #[test]
+    fn skeleton_needs_every_joint_valid() {
+        let joints: Vec<_> = (0..HAND_JOINT_COUNT)
+            .map(|_| joint(valid_flags()))
+            .collect();
+
+        let skeleton = validated_hand_skeleton(&joints).unwrap();
+        assert_eq!(skeleton.len(), HAND_JOINT_COUNT);
+        assert_eq!(skeleton[0].position, Vec3::new(0.01, 0.02, 0.03));
+
+        // one invalid joint among 26 valid ones invalidates the whole skeleton
+        for index in [0, 13, HAND_JOINT_COUNT - 1] {
+            let mut joints = joints.clone();
+            joints[index] = joint(SpaceLocationFlags::POSITION_VALID);
+
+            assert!(validated_hand_skeleton(&joints).is_none());
+        }
+    }
+
+    #[test]
+    fn skeleton_rejects_non_finite_joint() {
+        let mut joints: Vec<_> = (0..HAND_JOINT_COUNT)
+            .map(|_| joint(valid_flags()))
+            .collect();
+        joints[7].pose.position.x = f32::NAN;
+
+        assert!(validated_hand_skeleton(&joints).is_none());
+    }
+
+    fn identity_pose() -> Pose {
+        Pose {
+            position: Vec3::ZERO,
+            orientation: Quat::IDENTITY,
+        }
+    }
+
+    #[test]
+    fn an_unchanged_future_pose_gives_no_spin() {
+        // to_scaled_axis() reports a zero vector for a zero rotation, so this is not a constant
+        // spin and no motion threshold is needed to get here.
+        let (linear, angular) = pose_delta_velocity(identity_pose(), identity_pose(), 0.01).unwrap();
+
+        assert_eq!(linear, Vec3::ZERO);
+        assert_eq!(angular, Vec3::ZERO);
+    }
+
+    #[test]
+    fn a_slow_rotation_is_kept() {
+        // Half a degree in 10ms: a real rotation, slow enough that a motion threshold would have
+        // reported no motion at all.
+        let step = 0.5_f32.to_radians();
+        let time_offset_s = 0.01;
+
+        let (_, angular) = pose_delta_velocity(
+            identity_pose(),
+            Pose {
+                position: Vec3::ZERO,
+                orientation: Quat::from_rotation_y(step),
+            },
+            time_offset_s,
+        )
+        .unwrap();
+
+        assert!((angular.length() - step / time_offset_s).abs() < 1e-3);
+        assert!((angular.normalize() - Vec3::Y).length() < 1e-3);
+    }
+
+    #[test]
+    fn a_fast_rotation_reports_its_own_magnitude() {
+        let step = 90_f32.to_radians();
+        let time_offset_s = 0.02;
+
+        let (_, angular) = pose_delta_velocity(
+            identity_pose(),
+            Pose {
+                position: Vec3::ZERO,
+                orientation: Quat::from_rotation_z(step),
+            },
+            time_offset_s,
+        )
+        .unwrap();
+
+        assert!((angular.length() - step / time_offset_s).abs() < 1e-2);
+        assert!((angular.normalize() - Vec3::Z).length() < 1e-3);
+    }
+
+    #[test]
+    fn the_linear_velocity_comes_from_the_future_pose() {
+        let future = Pose {
+            position: Vec3::new(0.02, 0.0, 0.0),
+            orientation: Quat::IDENTITY,
+        };
+
+        let (linear, _) = pose_delta_velocity(identity_pose(), future, 0.02).unwrap();
+
+        assert!((linear - Vec3::X).length() < 1e-5);
+    }
+
+    #[test]
+    fn no_velocity_without_a_usable_pair_of_poses() {
+        let current = identity_pose();
+
+        // a non-finite future position
+        assert!(pose_delta_velocity(
+            current,
+            Pose {
+                position: Vec3::new(f32::NAN, 0.0, 0.0),
+                orientation: Quat::IDENTITY,
+            },
+            0.01
+        )
+        .is_none());
+
+        // a degenerate future rotation
+        assert!(pose_delta_velocity(
+            current,
+            Pose {
+                position: Vec3::ZERO,
+                orientation: Quat::from_xyzw(0.0, 0.0, 0.0, 0.0),
+            },
+            0.01
+        )
+        .is_none());
+
+        // a non-finite current rotation
+        assert!(pose_delta_velocity(
+            Pose {
+                position: Vec3::ZERO,
+                orientation: Quat::from_xyzw(f32::INFINITY, 0.0, 0.0, 1.0),
+            },
+            current,
+            0.01
+        )
+        .is_none());
+
+        // an offset that is not a duration
+        assert!(pose_delta_velocity(current, current, 0.0).is_none());
+        assert!(pose_delta_velocity(current, current, -0.01).is_none());
+        assert!(pose_delta_velocity(current, current, f32::NAN).is_none());
+    }
+}
