+
+/// How the client reacts to one server packet while the handshake is still open.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum HandshakeStep {
+    /// The wait continues. `preparing` is set only for the marker that opened the longer window,
+    /// so the user is told once that SteamVR is being prepared.
+    KeepWaiting { preparing: bool },
+    /// The handshake is over, with this outcome.
+    Done(HandshakeOutcome),
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum HandshakeOutcome {
+    /// The stream can start.
+    StartStream,
+    /// SteamVR is restarting. The permission is spent.
+    Restarting,
+    /// A PCVR issue the user has to act on, as a stable reason code.
+    Issue(&'static str),
+    /// The server never answered inside the normal window. Nothing was started, so this is the
+    /// ordinary slow or gone server, not a restart problem.
+    Timeout,
+    /// The server claimed a restart attempt and then stopped answering. The attempt is not
+    /// repeated: reconnecting has to ask the user again.
+    RestartTimeout,
+    /// The server is gone.
+    Disconnected,
+    /// A packet that cannot be part of this handshake.
+    Unexpected,
+}
+
+/// The state of the wait between the stream config and the first server packet.
+///
+/// The deadline starts at the normal handshake timeout, so a connection that streams is decided
+/// exactly as before. It is extended once, by the preparing marker, and only when this handshake
+/// was allowed to authorize the attempt: an unauthorized or repeated marker cannot make the client
+/// wait longer.
+#[derive(Debug, Clone, Copy)]
+struct ServerHandshake {
+    /// This handshake advertised an unspent permission.
+    restart_permitted: bool,
+    /// The permission is spent, by the marker or by Restarting. One use per client context.
+    permission_spent: bool,
+    /// The marker was already accepted, so the window cannot grow again.
+    preparing_seen: bool,
+    deadline: Instant,
+}
+
+impl ServerHandshake {
+    fn new(restart_permitted: bool, now: Instant) -> Self {
+        Self {
+            restart_permitted,
+            // A handshake without a permission starts already spent, so no marker can be accepted.
+            permission_spent: !restart_permitted,
+            preparing_seen: false,
+            deadline: now + HANDSHAKE_ACTION_TIMEOUT,
+        }
+    }
+
+    fn remaining(&self, now: Instant) -> Duration {
+        self.deadline.saturating_duration_since(now)
+    }
+
+    fn is_expired(&self, now: Instant) -> bool {
+        now >= self.deadline
+    }
+
+    /// True while this handshake still holds the permission that the marker spends.
+    fn accepts_marker(&self) -> bool {
+        !self.permission_spent
+    }
+
+    fn on_packet(&mut self, packet: &ServerControlPacket, now: Instant) -> HandshakeStep {
+        match packet {
+            ServerControlPacket::StartStream => HandshakeStep::Done(HandshakeOutcome::StartStream),
+            ServerControlPacket::Restarting => {
+                // A server that skips the marker is still trusted here, for compatibility: the
+                // outcome is the same, and the permission must be spent either way.
+                self.permission_spent = true;
+
+                HandshakeStep::Done(HandshakeOutcome::Restarting)
+            }
+            ServerControlPacket::Reserved(reason) if reason == RESTART_PREPARING_MARKER => {
+                if !self.restart_permitted {
+                    // The server claims an attempt this handshake never authorized. It is a
+                    // cross-component violation, not a reason to wait.
+                    return HandshakeStep::Done(HandshakeOutcome::Unexpected);
+                }
+
+                if !self.accepts_marker() {
+                    if self.preparing_seen {
+                        // The permission is already spent by an earlier marker. The wait continues,
+                        // but the window is never extended again.
+                        return HandshakeStep::KeepWaiting { preparing: false };
+                    }
+
+                    // The permission was spent by something else, a legacy Restarting, so this
+                    // handshake has no attempt to prepare and the marker cannot be part of it.
+                    return HandshakeStep::Done(HandshakeOutcome::Unexpected);
+                }
+
+                // The permission is spent by the marker: the server owns the attempt from now on,
+                // and this client context must not authorize another one.
+                self.permission_spent = true;
+                self.preparing_seen = true;
+                self.deadline = now + RESTART_PREPARING_TIMEOUT;
+
+                HandshakeStep::KeepWaiting { preparing: true }
+            }
+            ServerControlPacket::Reserved(reason) if reason == RESTART_CONSENT_REQUIRED_REASON => {
+                HandshakeStep::Done(HandshakeOutcome::Issue("restart_required"))
+            }
+            ServerControlPacket::Reserved(reason) if reason == RESTART_FAILED_REASON => {
+                HandshakeStep::Done(HandshakeOutcome::Issue("restart_failed"))
+            }
+            _ => HandshakeStep::Done(HandshakeOutcome::Unexpected),
+        }
+    }
+}
