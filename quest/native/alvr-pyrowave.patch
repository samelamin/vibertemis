+        // Nothing changed: the restart goes ahead.
+        assert!(restart_preconditions_hold(
+            true,
+            true,
+            true,
+            LifecycleState::Resumed,
+            true
+        ));
+
+        // Each single failure aborts it, so no stale config is ever persisted.
+        assert!(!restart_preconditions_hold(
+            false,
+            true,
+            true,
+            LifecycleState::Resumed,
+            true
+        ));
+        assert!(!restart_preconditions_hold(
+            true,
+            false,
+            true,
+            LifecycleState::Resumed,
+            true
+        ));
+        assert!(!restart_preconditions_hold(
+            true,
+            true,
+            false,
+            LifecycleState::Resumed,
+            true
+        ));
+        assert!(!restart_preconditions_hold(
+            true,
+            true,
+            true,
+            LifecycleState::ShuttingDown,
+            true
+        ));
+        assert!(!restart_preconditions_hold(
+            true,
+            true,
+            true,
+            LifecycleState::Resumed,
+            false
+        ));
+    }
