+#pragma once
+// Selective port from Galaxy XR ALVR Research (MIT); see native source notices.
+#include "VideoEncoder.h"
+#include <d3d11_4.h>
+#include <wrl.h>
+#include <vulkan/vulkan.h>
+#include "pyrowave.h"
+#include <vector>
+#include <string>
+
+// Resolve lazily from the driver directory. Missing PyroWave/Vulkan DLLs never
+// prevent NVENC AV1/HEVC from loading.
+struct PyroApi {
+    HMODULE module = nullptr;
+#define PYRO_FN(name) decltype(&::name) name = nullptr;
+    PYRO_FN(pyrowave_create_device_by_compat)
+    PYRO_FN(pyrowave_device_confirm_interop_support)
+    PYRO_FN(pyrowave_device_destroy)
+    PYRO_FN(pyrowave_image_create)
+    PYRO_FN(pyrowave_image_get_image_view)
+    PYRO_FN(pyrowave_image_destroy)
+    PYRO_FN(pyrowave_encoder_create)
+    PYRO_FN(pyrowave_encoder_destroy)
+    PYRO_FN(pyrowave_encoder_encode_gpu_synchronous)
+    PYRO_FN(pyrowave_encoder_compute_num_packets)
+    PYRO_FN(pyrowave_encoder_packetize)
+    PYRO_FN(pyrowave_sync_object_create)
+    PYRO_FN(pyrowave_sync_object_get_semaphore)
+    PYRO_FN(pyrowave_sync_object_cpu_wait)
+    PYRO_FN(pyrowave_sync_object_destroy)
+#undef PYRO_FN
+    bool Load();
+    ~PyroApi() { if (module) FreeLibrary(module); }
+};
+
+class VideoEncoderPyroWave : public VideoEncoder {
+public:
+    VideoEncoderPyroWave(std::shared_ptr<CD3DRender>, int, int, ID3D11Texture2D* [3]);
+    ~VideoEncoderPyroWave();
+    void Initialize() override;
+    void Shutdown() override;
+    void Transmit(ID3D11Texture2D*, uint64_t, uint64_t, bool) override;
+private:
+    PyroApi api;
+    std::shared_ptr<CD3DRender> render;
+    int width, height;
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> planes[3];
+    Microsoft::WRL::ComPtr<ID3D11Device5> device;
+    Microsoft::WRL::ComPtr<ID3D11DeviceContext4> context;
+    Microsoft::WRL::ComPtr<ID3D11Fence> renderFence, completeFence;
+    HANDLE fenceEvent = nullptr;
+    uint64_t fenceValue = 0;
+    pyrowave_device pyro = nullptr;
+    pyrowave_encoder encoder = nullptr;
+    pyrowave_sync_object completion = nullptr;
+    pyrowave_image images[3] = {};
+    pyrowave_gpu_buffers buffers = {};
+    std::vector<uint8_t> bitstream;
+    uint64_t bitrate = 0;
+    uint32_t fps = 0;
+    bool pending = false;
+};
diff --git a/alvr/server_openvr/cpp/platform/win32/d3d-render-utils/RenderPipelinePlanar.cpp b/alvr/server_openvr/cpp/platform/win32/d3d-render-utils/RenderPipelinePlanar.cpp
new file mode 100644
index 0000000..33c7069
--- /dev/null
+++ b/alvr/server_openvr/cpp/platform/win32/d3d-render-utils/RenderPipelinePlanar.cpp
@@ -0,0 +1,107 @@
+#include "RenderPipelinePlanar.h"
+
+namespace d3d_render_utils {
+
+RenderPipelinePlanar::RenderPipelinePlanar(ID3D11Device* device) {
+    mDevice = device;
+    mDevice->GetImmediateContext(&mImmediateContext);
+}
+
+void RenderPipelinePlanar::Initialize(
+    std::vector<ID3D11Texture2D*> inputTextures,
+    ID3D11VertexShader* quadVertexShader,
+    std::vector<uint8_t>& pixelShaderCSO,
+    ID3D11Texture2D* renderTargets[3],
+    ID3D11Buffer* shaderBuffer
+) {
+    mInputTextureViews.clear();
+    for (auto tex : inputTextures) {
+        Microsoft::WRL::ComPtr<ID3D11ShaderResourceView> resourceView;
+        OK_OR_THROW(
+            mDevice->CreateShaderResourceView(tex, nullptr, resourceView.GetAddressOf()),
+            "Failed to create input texture resource view."
+        );
+        mInputTextureViews.push_back(resourceView);
+    }
+
+    D3D11_TEXTURE2D_DESC firstDesc = {};
+    for (int i = 0; i < 3; i++) {
+        OK_OR_THROW(
+            mDevice->CreateRenderTargetView(renderTargets[i], nullptr, &mRenderTargetViews[i]),
+            "Failed to create plane ID3D11RenderTargetView."
+        );
+
+        D3D11_TEXTURE2D_DESC desc;
+        renderTargets[i]->GetDesc(&desc);
+        if (i == 0) {
+            firstDesc = desc;
+        } else if (desc.Width != firstDesc.Width || desc.Height != firstDesc.Height) {
+            // D3D11 requires every bound target to share dimensions, and silently clipping to the
+            // smallest would corrupt whichever plane is larger.
+            throw MakeException(
+                "Planar render targets must match: plane 0 is %ux%u, plane %d is %ux%u",
+                firstDesc.Width,
+                firstDesc.Height,
+                i,
+                desc.Width,
+                desc.Height
+            );
+        }
+    }
+
+    mViewport.Width = (FLOAT)firstDesc.Width;
+    mViewport.Height = (FLOAT)firstDesc.Height;
+    mViewport.MinDepth = 0.0f;
+    mViewport.MaxDepth = 1.0f;
+    mViewport.TopLeftX = 0.0f;
+    mViewport.TopLeftY = 0.0f;
+
+    mShaderBuffer = shaderBuffer;
+    mVertexShader = quadVertexShader;
+    mPixelShader = CreatePixelShader(mDevice.Get(), pixelShaderCSO);
+
+    // Plain overwrite. The planes are fully written every frame, so there is nothing to blend
+    // with, and each target carries one channel.
+    D3D11_BLEND_DESC blendDesc = { 0 };
+    for (int i = 0; i < 3; i++) {
+        blendDesc.RenderTarget[i].BlendEnable = FALSE;
+        blendDesc.RenderTarget[i].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+    }
+    blendDesc.IndependentBlendEnable = TRUE;
+    OK_OR_THROW(
+        mDevice->CreateBlendState(&blendDesc, &mBlendState), "Failed to create blend state."
+    );
+}
+
+void RenderPipelinePlanar::Render(ID3D11DeviceContext* otherContext) {
+    ID3D11DeviceContext* context = otherContext != nullptr ? otherContext : mImmediateContext.Get();
+
+    ID3D11RenderTargetView* rtvs[3]
+        = { mRenderTargetViews[0].Get(), mRenderTargetViews[1].Get(), mRenderTargetViews[2].Get() };
+    context->OMSetRenderTargets(3, rtvs, nullptr);
+    context->RSSetViewports(1, &mViewport);
+    context->OMSetBlendState(mBlendState.Get(), nullptr, 0xffffffff);
+
+    if (mShaderBuffer != nullptr) {
+        context->PSSetConstantBuffers(0, 1, mShaderBuffer.GetAddressOf());
+    }
+
+    std::vector<ID3D11ShaderResourceView*> inputTextureViewPtrs;
+    for (auto texView : mInputTextureViews) {
+        inputTextureViewPtrs.push_back(texView.Get());
+    }
+    context->PSSetShaderResources(0, (UINT)inputTextureViewPtrs.size(), &inputTextureViewPtrs[0]);
+
+    context->VSSetShader(mVertexShader.Get(), nullptr, 0);
+    context->PSSetShader(mPixelShader.Get(), nullptr, 0);
+
+    context->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+    context->Draw(4, 0);
+
+    // Leave nothing bound: these targets are handed to PyroWave, and a still-bound RTV would make
+    // the later SRV bind a no-op.
+    ID3D11RenderTargetView* none[3] = { nullptr, nullptr, nullptr };
+    context->OMSetRenderTargets(3, none, nullptr);
+}
+
+}
diff --git a/alvr/server_openvr/cpp/platform/win32/d3d-render-utils/RenderPipelinePlanar.h b/alvr/server_openvr/cpp/platform/win32/d3d-render-utils/RenderPipelinePlanar.h
new file mode 100644
index 0000000..55daafe
--- /dev/null
+++ b/alvr/server_openvr/cpp/platform/win32/d3d-render-utils/RenderPipelinePlanar.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include "RenderUtils.h"
+
+namespace d3d_render_utils {
+
+// A RenderPipeline variant that writes three single-component render targets in one pass, for
+// producing planar YCbCr. RenderPipeline binds exactly one target, and three passes over the same
+// input would be three times the sampling for no reason.
+//
+// All three targets must have the same dimensions, which is why this is 4:4:4 only. Subsampled
+// chroma would need either a second half-resolution pass or the differently-sized-target trick
+// rgbtoyuv420.hlsl relies on.
+class RenderPipelinePlanar {
+public:
+    RenderPipelinePlanar(ID3D11Device* device);
+
+    void Initialize(
+        std::vector<ID3D11Texture2D*> inputTextures,
+        ID3D11VertexShader* quadVertexShader,
+        std::vector<uint8_t>& pixelShaderCSO,
+        ID3D11Texture2D* renderTargets[3],
+        ID3D11Buffer* shaderBuffer = nullptr
+    );
+
+    void Render(ID3D11DeviceContext* otherContext = nullptr);
+
+private:
+    D3D11_VIEWPORT mViewport;
+
+    Microsoft::WRL::ComPtr<ID3D11Device> mDevice;
+    Microsoft::WRL::ComPtr<ID3D11DeviceContext> mImmediateContext;
+    std::vector<Microsoft::WRL::ComPtr<ID3D11ShaderResourceView>> mInputTextureViews;
+    Microsoft::WRL::ComPtr<ID3D11RenderTargetView> mRenderTargetViews[3];
+    Microsoft::WRL::ComPtr<ID3D11Buffer> mShaderBuffer;
+    Microsoft::WRL::ComPtr<ID3D11VertexShader> mVertexShader;
+    Microsoft::WRL::ComPtr<ID3D11PixelShader> mPixelShader;
+    Microsoft::WRL::ComPtr<ID3D11BlendState> mBlendState;
+};
+}
