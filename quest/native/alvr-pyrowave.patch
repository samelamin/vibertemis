diff --git a/alvr/client_openxr/src/pcvr_request.rs b/alvr/client_openxr/src/pcvr_request.rs
new file mode 100644
index 0000000..71631e7
--- /dev/null
+++ b/alvr/client_openxr/src/pcvr_request.rs
@@ -0,0 +1,139 @@
+use alvr_packets::PcvrRequest;
+#[cfg(target_os = "android")]
+fn android_request() -> alvr_common::anyhow::Result<(PcvrRequest, Option<std::time::Instant>)> {
+    use alvr_session::CodecType;
+    use jni::{
+        objects::{JObject, JValue},
+        JavaVM,
+    };
+    let context = ndk_context::android_context();
+    let vm = unsafe { JavaVM::from_raw(context.vm().cast())? };
+    let mut env = vm.attach_current_thread()?;
+    let activity = unsafe { JObject::from_raw(context.context().cast()) };
+    let intent = env
+        .call_method(&activity, "getIntent", "()Landroid/content/Intent;", &[])?
+        .l()?;
+    let mut string = |key: &str| -> alvr_common::anyhow::Result<Option<CodecType>> {
+        let key = env.new_string(key)?;
+        let value = env
+            .call_method(
+                &intent,
+                "getStringExtra",
+                "(Ljava/lang/String;)Ljava/lang/String;",
+                &[JValue::Object(&key)],
+            )?
+            .l()?;
+        if value.is_null() {
+            return Ok(None);
+        }
+        let value: String = env.get_string(&value.into())?.into();
+        Ok(match value.as_str() {
+            "PyroWave" => Some(CodecType::PyroWave),
+            "AV1" => Some(CodecType::AV1),
+            "Hevc" => Some(CodecType::Hevc),
+            _ => None,
+        })
+    };
+    let codec = string("vq_pcvr_codec")?;
+    let fallback = string("vq_pcvr_fallback")?.filter(|codec| *codec != CodecType::PyroWave);
+    let mut boolean = |key: &str| -> alvr_common::anyhow::Result<bool> {
+        let key = env.new_string(key)?;
+        Ok(env
+            .call_method(
+                &intent,
+                "getBooleanExtra",
+                "(Ljava/lang/String;Z)Z",
+                &[JValue::Object(&key), JValue::Bool(0)],
+            )?
+            .z()?)
+    };
+    let travel = boolean("vq_pcvr_travel")?;
+    let allowed = boolean("vq_pcvr_allow_restart")?;
+    let key = env.new_string("vq_pcvr_restart_until_ms")?;
+    let deadline = env
+        .call_method(
+            &intent,
+            "getLongExtra",
+            "(Ljava/lang/String;J)J",
+            &[JValue::Object(&key), JValue::Long(0)],
+        )?
+        .j()?;
+    let bitrate_key = env.new_string("vq_pcvr_bitrate_mbps")?;
+    let bitrate = env
+        .call_method(
+            &intent,
+            "getIntExtra",
+            "(Ljava/lang/String;I)I",
+            &[JValue::Object(&bitrate_key), JValue::Int(0)],
+        )?
+        .i()?;
+    let bitrate_ceiling_mbps = (5..=200).contains(&bitrate).then_some(bitrate as u64);
+    let now = env
+        .call_static_method("android/os/SystemClock", "elapsedRealtime", "()J", &[])?
+        .j()?;
+    let remaining = deadline.saturating_sub(now);
+    let allow_restart = allowed && remaining > 0 && remaining <= 120000;
+    Ok((
+        PcvrRequest {
+            codec,
+            fallback,
+            travel,
+            allow_restart,
+            bitrate_ceiling_mbps,
+        },
+        allow_restart.then(|| {
+            std::time::Instant::now() + std::time::Duration::from_millis(remaining as u64)
+        }),
+    ))
+}
+pub fn read() -> (PcvrRequest, Option<std::time::Instant>) {
+    #[cfg(target_os = "android")]
+    {
+        android_request().unwrap_or_else(|error| {
+            alvr_common::warn!("PCVR options unavailable: {error}");
+            (PcvrRequest::default(), None)
+        })
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        (PcvrRequest::default(), None)
+    }
+}
+
+// Called only after actual decoder output, never from a requested preference.
+pub fn report_codec(codec: alvr_session::CodecType) {
+    #[cfg(target_os = "android")]
+    {
+        use jni::{
+            objects::{JObject, JValue},
+            JavaVM,
+        };
+        let name = match codec {
+            alvr_session::CodecType::PyroWave => "PyroWave",
+            alvr_session::CodecType::AV1 => "AV1",
+            alvr_session::CodecType::Hevc => "HEVC",
+            alvr_session::CodecType::H264 => "H.264",
+        };
+        let context = ndk_context::android_context();
+        let result = (|| -> alvr_common::anyhow::Result<()> {
+            let vm = unsafe { JavaVM::from_raw(context.vm().cast())? };
+            let mut env = vm.attach_current_thread()?;
+            let activity = unsafe { JObject::from_raw(context.context().cast()) };
+            let text = env.new_string(name)?;
+            let result = env.call_method(
+                &activity,
+                "onPcvrCodec",
+                "(Ljava/lang/String;)V",
+                &[JValue::Object(&text)],
+            );
+            if result.is_err() {
+                let _ = env.exception_clear();
+            }
+            result?;
+            Ok(())
+        })();
+        if let Err(error) = result {
+            alvr_common::warn!("Could not record decoded codec: {error}");
+        }
+    }
+}
