@@ -0,0 +1,520 @@
+//! Native SteamVR restart for the Vibertemis driver.
+//!
+//! A short-lived Vibertemis manager worker performs the restart: it preflights its own identity and
+//! hashes, prints `VIBERTEMIS_VR_RESTART_READY` and then waits. Nothing happens until the driver
+//! writes `VIBERTEMIS_VR_RESTART_COMMIT` on the worker stdin, so a broken worker can never take
+//! SteamVR down. The driver never kills vrserver: a failed preflight only kills the helper this
+//! module spawned.
+use alvr_common::{
+    anyhow::{anyhow, bail, Result},
+    info,
+};
+use std::{
+    io::{BufRead, Read, Write},
+    process::{Child, ChildStdin},
+    sync::atomic::{AtomicBool, Ordering},
+    time::Duration,
+};
+
+/// Ack line written by the manager worker, only after its preflight succeeded.
+pub const READY_TOKEN: &str = "VIBERTEMIS_VR_RESTART_READY";
+/// Commit line: the only thing that lets the worker proceed to restart SteamVR.
+pub const COMMIT_TOKEN: &str = "VIBERTEMIS_VR_RESTART_COMMIT";
+/// Protocol line bound, terminator included. Anything longer is refused instead of buffered.
+const MAX_LINE_BYTES: usize = 128;
+/// A slower worker is considered stuck and gets killed.
+pub const READY_TIMEOUT: Duration = Duration::from_secs(10);
+
+/// At most one restart per server process. It is given back when the preparation fails, so a later
+/// explicit attempt is still possible, and kept once the restart was committed.
+static RESTART_ATTEMPTED: AtomicBool = AtomicBool::new(false);
+
+/// The ownership of one claimed attempt.
+///
+/// The claim is given back by dropping this guard and by nothing else, so exactly one release
+/// happens per claim: a preparation that already gave its claim back cannot clear a claim made in
+/// the meantime. Once a commit spends the claim it stays held, which is what makes the restart
+/// one-shot per server process.
+pub struct RestartAttemptGuard {
+    /// `None` once the claim was spent. The flag is a static, so holding or giving back the
+    /// reference to it frees nothing.
+    flag: Option<&'static AtomicBool>,
+}
+
+impl RestartAttemptGuard {
+    /// The one allowed restart is spent: the flag stays claimed and no later attempt may start.
+    fn spend(mut self) {
+        self.flag = None;
+    }
+}
+
+impl Drop for RestartAttemptGuard {
+    fn drop(&mut self) {
+        // An unspent claim goes back with its owner, and only once.
+        if let Some(flag) = self.flag.take() {
+            flag.store(false, Ordering::SeqCst);
+        }
+    }
+}
+
+/// Claims the single restart of this server process, if it is still available.
+///
+/// The returned guard owns the claim and must be handed to [`prepare`], which keeps it alive for
+/// as long as the restart can still be abandoned. Dropping it any other way, without handing it
+/// over, is what gives the claim back.
+pub fn try_begin_attempt() -> Option<RestartAttemptGuard> {
+    claim_attempt(&RESTART_ATTEMPTED)
+}
+
+fn claim_attempt(flag: &'static AtomicBool) -> Option<RestartAttemptGuard> {
+    if flag.swap(true, Ordering::SeqCst) {
+        None
+    } else {
+        Some(RestartAttemptGuard { flag: Some(flag) })
+    }
+}
+
+/// Reads a single protocol line and returns it without its terminator.
+///
+/// The line is bounded to MAX_LINE_BYTES bytes, terminator included, and must be terminated by LF.
+/// A CR directly before that LF is accepted, because Windows workers write CRLF; nothing else is
+/// removed, so a padded, decorated or non-ASCII line never reaches the token comparison.
+pub fn read_protocol_line<R: Read>(reader: R) -> Result<String> {
+    let mut reader = std::io::BufReader::new(reader).take((MAX_LINE_BYTES + 1) as u64);
+
+    let mut line = Vec::new();
+    reader.read_until(b'\n', &mut line)?;
+
+    // The one extra byte of the bound is the only witness of an over-long line: read_until cannot
+    // tell a line that is exactly at the limit from a truncated read.
+    if line.len() > MAX_LINE_BYTES {
+        bail!("restart protocol line exceeds {MAX_LINE_BYTES} bytes");
+    }
+
+    // An EOF without LF is a partial line: the peer is not speaking the protocol.
+    if !line.ends_with(b"\n") {
+        bail!("restart protocol line is not terminated");
+    }
+    line.pop();
+
+    if line.ends_with(b"\r") {
+        line.pop();
+    }
+
+    if !line.is_ascii() {
+        bail!("invalid restart protocol line: expected ASCII");
+    }
+
+    String::from_utf8(line).map_err(|e| anyhow!("invalid restart protocol line: {e}"))
+}
+
+/// The ack is the exact token. Nothing is trimmed, so a line that merely contains or is padded with
+/// the token is not an ack.
+pub fn is_ready(line: &str) -> bool {
+    line == READY_TOKEN
+}
+
+// The helper variant is only constructed where a manager worker exists.
+#[allow(dead_code)]
+enum Backend {
+    /// The retained manager worker. Killed unless the restart is committed.
+    Helper { child: Child, stdin: ChildStdin },
+    /// No manager worker on this platform: the running dashboard performs the restart.
+    Dashboard,
+}
+
+/// What the caller must do after a successful commit. Each variant exists only on the platform that
+/// produces it, so both are platform conditional.
+#[allow(dead_code)]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CommitOutcome {
+    /// The retained manager worker now cycles SteamVR on its own, so the driver still has to exit
+    /// for the new driver instance to be loaded.
+    ManagedQuit,
+    /// The running dashboard was notified and it performs the SteamVR exit itself. The driver must
+    /// not ask for a second, competing restart.
+    DashboardHandlesExit,
+}
+
+impl CommitOutcome {
+    pub fn needs_managed_quit(self) -> bool {
+        matches!(self, Self::ManagedQuit)
+    }
+}
+
+/// A prepared restart that is still under the driver's control. Dropping it without committing
+/// kills the spawned worker and leaves SteamVR alone.
+pub struct RestartWorker {
+    backend: Option<Backend>,
+    /// The claimed attempt, owned for as long as the restart can still be abandoned. A successful
+    /// commit spends it, and the drop of this handle gives it back otherwise.
+    attempt: Option<RestartAttemptGuard>,
+}
+
+impl RestartWorker {
+    fn new(backend: Backend, attempt: RestartAttemptGuard) -> Self {
+        Self {
+            backend: Some(backend),
+            attempt: Some(attempt),
+        }
+    }
+
+    /// Hands the restart over to the worker. After this the handle is detached, so the worker
+    /// outlives the driver process and cycles SteamVR on its own.
+    ///
+    /// Nothing is detached before the commit is known to have succeeded: on error this handle is
+    /// dropped, which kills and reaps only the helper spawned here and gives the one-shot attempt
+    /// back.
+    pub fn commit(mut self) -> Result<CommitOutcome> {
+        let Some(backend) = self.backend.as_mut() else {
+            bail!("restart worker already used");
+        };
+
+        let outcome = match backend {
+            Backend::Helper { stdin, .. } => {
+                // The fallible writes happen while the worker is still owned, so a broken pipe
+                // still reaches the cleanup below instead of orphaning the helper.
+                stdin.write_all(COMMIT_TOKEN.as_bytes())?;
+                stdin.write_all(b"\n")?;
+                stdin.flush()?;
+
+                CommitOutcome::ManagedQuit
+            }
+            Backend::Dashboard => {
+                crate::notify_restart_driver();
+
+                CommitOutcome::DashboardHandlesExit
+            }
+        };
+
+        // The single restart of this server process is spent, and the worker is detached.
+        self.detach();
+
+        info!("Committed the managed SteamVR restart");
+
+        Ok(outcome)
+    }
+
+    /// The restart belongs to the worker now: the claim is spent and the worker is detached, so this
+    /// handle holds neither of them anymore.
+    fn detach(&mut self) {
+        // The flag is static, so letting go of the claim here frees nothing and leaves it claimed.
+        if let Some(attempt) = self.attempt.take() {
+            attempt.spend();
+        }
+        // Dropping a Child does not kill it: the worker keeps running.
+        self.backend = None;
+    }
+}
+
+impl Drop for RestartWorker {
+    fn drop(&mut self) {
+        // Only the helper spawned here is ever killed. vrserver and SteamVR are not touched.
+        if let Some(Backend::Helper { mut child, .. }) = self.backend.take() {
+            let _ = child.kill();
+            let _ = child.wait();
+        }
+
+        // An unspent claim goes back with its owner, so a later explicit attempt is possible. The
+        // claim is released by this drop only, so nothing that already happened during the
+        // preparation can clear a claim made in the meantime.
+        drop(self.attempt.take());
+    }
+}
+
+#[cfg(windows)]
+mod imp {
+    use super::{Backend, RestartAttemptGuard, RestartWorker};
+    use crate::FILESYSTEM_LAYOUT;
+    use alvr_common::{
+        anyhow::{anyhow, bail, Result},
+        info,
+    };
+    use std::{
+        io::Read,
+        os::windows::process::CommandExt,
+        path::PathBuf,
+        process::{Command, Stdio},
+        sync::mpsc,
+        thread,
+    };
+
+    /// Keeps a console window from flashing for the worker.
+    const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+    const VRSERVER_EXE: &str = "vrserver.exe";
+
+    /// The manager shipped with this exact driver installation. No PATH lookup, no shell.
+    pub(super) fn manager_exe() -> Result<PathBuf> {
+        let layout = FILESYSTEM_LAYOUT
+            .get()
+            .ok_or_else(|| anyhow!("filesystem layout is not initialized"))?;
+
+        let exe = layout
+            .openvr_driver_root_dir
+            .parent()
+            .ok_or_else(|| {
+                anyhow!(
+                    "cannot locate the manager next to the driver root: {}",
+                    layout.openvr_driver_root_dir.display()
+                )
+            })?
+            .join("manager")
+            .join(alvr_filesystem::exec_fname("VibertemisManager.App"));
+
+        if !exe.is_file() {
+            bail!(
+                "Vibertemis manager worker is missing: {}. SteamVR cannot be restarted from the driver.",
+                exe.display()
+            );
+        }
+
+        Ok(exe)
+    }
+
+    /// The driver is loaded by the very vrserver instance it runs inside, so that process is the
+    /// one to cycle. Looking it up by name would pick the first vrserver of any user session,
+    /// which can be another user's SteamVR, and the manager's own parent validation would then
+    /// refuse the restart for the wrong reason, or cycle the wrong SteamVR.
+    fn vrserver_pid() -> u32 {
+        std::process::id()
+    }
+
+    /// Waits for the preflight ack on a background thread, so a stuck helper cannot block the
+    /// handshake forever.
+    fn await_ready(stdout: impl Read + Send + 'static) -> Result<()> {
+        let (sender, receiver) = mpsc::channel();
+        thread::spawn(move || {
+            let _ = sender.send(super::read_protocol_line(stdout));
+        });
+
+        match receiver.recv_timeout(super::READY_TIMEOUT) {
+            Ok(Ok(line)) if super::is_ready(&line) => Ok(()),
+            Ok(Ok(line)) => bail!("Vibertemis manager refused the SteamVR restart: {line:?}"),
+            Ok(Err(e)) => Err(e),
+            Err(mpsc::RecvTimeoutError::Timeout) => bail!(
+                "Vibertemis manager did not confirm the restart within {:?}",
+                super::READY_TIMEOUT
+            ),
+            Err(mpsc::RecvTimeoutError::Disconnected) => {
+                bail!("Vibertemis manager preflight channel closed")
+            }
+        }
+    }
+
+    pub(super) fn prepare(attempt: RestartAttemptGuard) -> Result<RestartWorker> {
+        let exe = manager_exe()?;
+        let pid = vrserver_pid();
+
+        info!(
+            "Preparing SteamVR restart with {} for this driver's {VRSERVER_EXE} pid {pid}",
+            exe.display()
+        );
+
+        let mut child = Command::new(&exe)
+            .arg("--restart-vr")
+            .arg(pid.to_string())
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .creation_flags(CREATE_NO_WINDOW)
+            .spawn()
+            .map_err(|e| anyhow!("failed to start the Vibertemis manager worker: {e}"))?;
+
+        let Some(stdin) = child.stdin.take() else {
+            let _ = child.kill();
+            let _ = child.wait();
+            bail!("Vibertemis manager worker has no stdin pipe");
+        };
+        let Some(stdout) = child.stdout.take() else {
+            let _ = child.kill();
+            let _ = child.wait();
+            bail!("Vibertemis manager worker has no stdout pipe");
+        };
+
+        let worker = RestartWorker::new(Backend::Helper { child, stdin }, attempt);
+
+        // On failure the worker is dropped here, which kills and reaps only that helper and gives
+        // the claim back exactly once.
+        await_ready(stdout)?;
+        info!("Vibertemis manager preflight succeeded");
+
+        Ok(worker)
+    }
+}
+
+#[cfg(not(windows))]
+mod imp {
+    use super::{Backend, RestartAttemptGuard, RestartWorker};
+    use alvr_common::{
+        anyhow::{bail, Result},
+        info,
+    };
+    use std::ffi::OsStr;
+
+    /// No manager worker on this platform: the running dashboard is the only supported restart
+    /// path. Without it the restart fails, and the client is told so instead of SteamVR quitting.
+    pub(super) fn prepare(attempt: RestartAttemptGuard) -> Result<RestartWorker> {
+        if sysinfo::System::new_all()
+            .processes_by_name(OsStr::new(alvr_filesystem::dashboard_fname()))
+            .next()
+            .is_some()
+        {
+            info!("No manager worker on this platform: asking the running dashboard to restart SteamVR");
+
+            Ok(RestartWorker::new(Backend::Dashboard, attempt))
+        } else {
+            bail!("Cannot restart SteamVR. No dashboard process found on local device.")
+        }
+    }
+}
+
+/// Starts a restart worker for a claimed attempt. An error means SteamVR was left untouched, and
+/// the claim is given back by the drop, so a later explicit attempt can start again.
+pub fn prepare(attempt: RestartAttemptGuard) -> Result<RestartWorker> {
+    imp::prepare(attempt)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A flag owned by the test, leaked so a claim can refer to it for the whole test.
+    fn test_flag() -> &'static AtomicBool {
+        Box::leak(Box::new(AtomicBool::new(false)))
+    }
+
+    #[test]
+    fn ready_line_is_parsed() {
+        let line = format!("{READY_TOKEN}\n");
+
+        // The contract: the terminator is consumed, the token is not.
+        assert_eq!(read_protocol_line(line.as_bytes()).unwrap(), READY_TOKEN);
+        assert!(is_ready(&read_protocol_line(line.as_bytes()).unwrap()));
+    }
+
+    #[test]
+    fn windows_line_ending_is_accepted() {
+        let line = format!("{READY_TOKEN}\r\n");
+
+        assert_eq!(read_protocol_line(line.as_bytes()).unwrap(), READY_TOKEN);
+        assert!(is_ready(&read_protocol_line(line.as_bytes()).unwrap()));
+    }
+
+    #[test]
+    fn only_the_exact_token_is_ready() {
+        assert!(is_ready(READY_TOKEN));
+
+        for line in [
+            String::new(),
+            "VIBERTEMIS_VR_RESTART_COMMIT".to_owned(),
+            "VIBERTEMIS_VR_RESTART_READY_MAYBE".to_owned(),
+            // whitespace is not trimmed: a padded line is not the ack
+            format!("{READY_TOKEN} "),
+            format!(" {READY_TOKEN}"),
+            format!("{READY_TOKEN}\t"),
+        ] {
+            assert!(!is_ready(&line), "{line:?} must not be an ack");
+        }
+    }
+
+    #[test]
+    fn protocol_line_is_bounded_including_the_terminator() {
+        // MAX_LINE_BYTES counts the terminator, so this one is exactly at the bound.
+        let at_bound = format!("{}\n", "A".repeat(MAX_LINE_BYTES - 1));
+        assert_eq!(
+            read_protocol_line(at_bound.as_bytes()).unwrap().len(),
+            MAX_LINE_BYTES - 1
+        );
+
+        let over_bound = format!("{}\n", "A".repeat(MAX_LINE_BYTES));
+        assert!(read_protocol_line(over_bound.as_bytes()).is_err());
+
+        // CRLF costs one more byte, so the same payload is now over the bound.
+        let crlf_over_bound = format!("{}\r\n", "A".repeat(MAX_LINE_BYTES - 1));
+        assert!(read_protocol_line(crlf_over_bound.as_bytes()).is_err());
+    }
+
+    #[test]
+    fn eof_without_newline_is_rejected() {
+        // A partial line is a broken protocol, not an ack.
+        assert!(read_protocol_line(READY_TOKEN.as_bytes()).is_err());
+        assert!(read_protocol_line(&b""[..]).is_err());
+    }
+
+    #[test]
+    fn non_ascii_line_is_rejected() {
+        let line = "VIBERTEMIS_VR_RESTART_REA\u{e9}Y\n";
+
+        assert!(read_protocol_line(line.as_bytes()).is_err());
+    }
+
+    #[test]
+    fn a_claim_has_exactly_one_owner() {
+        let flag = test_flag();
+
+        let attempt = claim_attempt(flag).expect("the first claim wins");
+        // While the claim is owned, no second attempt can claim the restart.
+        assert!(claim_attempt(flag).is_none());
+
+        // Dropping the owner gives the claim back, once.
+        drop(attempt);
+        assert!(claim_attempt(flag).is_some());
+    }
+
+    #[test]
+    fn a_spent_claim_is_never_given_back() {
+        let flag = test_flag();
+
+        claim_attempt(flag).unwrap().spend();
+
+        // The owner is gone and the flag stays claimed: the one restart of this process is spent.
+        assert!(claim_attempt(flag).is_none());
+    }
+
+    // The one-shot guard is process wide, so the whole contract is asserted in a single test: these
+    // steps cannot run in parallel.
+    #[test]
+    fn an_abandoned_attempt_never_clears_a_newer_claim() {
+        // A claimed attempt is owned, so nothing else claims the restart while it is being prepared.
+        let first = try_begin_attempt().expect("the first attempt claims the restart");
+        assert!(try_begin_attempt().is_none());
+
+        // A failed preparation: the claim went into the worker, and dropping it without a commit
+        // gives it back exactly once.
+        drop(RestartWorker {
+            backend: None,
+            attempt: Some(first),
+        });
+
+        // A newer claim, made after that failure. The abandoned attempt has no claim left, so
+        // nothing it does afterwards can clear this one.
+        let second = try_begin_attempt().expect("the failed preparation gave the claim back");
+        assert!(try_begin_attempt().is_none());
+
+        // A commit that never happened, because the handle was already used, gives it back too.
+        assert!(RestartWorker {
+            backend: None,
+            attempt: Some(second),
+        }
+        .commit()
+        .is_err());
+        let third = try_begin_attempt().expect("the failed commit gave the claim back");
+
+        // A committed restart spends the claim, so the single allowed restart of this server
+        // process is used up and stays used up.
+        RestartWorker {
+            backend: None,
+            attempt: Some(third),
+        }
+        .detach();
+        assert!(try_begin_attempt().is_none());
+    }
+
+    #[test]
+    fn only_the_helper_outcome_needs_a_managed_quit() {
+        // The manager worker cycles SteamVR but cannot unload the driver, so the driver must exit.
+        // The dashboard fallback performs the exit itself.
+        assert!(CommitOutcome::ManagedQuit.needs_managed_quit());
+        assert!(!CommitOutcome::DashboardHandlesExit.needs_managed_quit());
+    }
+}
