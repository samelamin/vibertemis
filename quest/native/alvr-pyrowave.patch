+// Selective codec port from Galaxy XR ALVR Research (MIT).
+#include "VideoEncoderPyroWave.h"
+#include "alvr_server/Logger.h"
+#include "alvr_server/Settings.h"
+#include "alvr_server/Utils.h"
+#include "alvr_server/bindings.h"
+#include "d3d-render-utils/RenderUtils.h"
+#include <dxgi1_2.h>
+#include <algorithm>
+#include <cstring>
+
+#define PW(call) do { auto result = (call); if (result != PYROWAVE_SUCCESS) \
+    throw MakeException("PyroWave %s failed (%d)", #call, int(result)); } while (0)
+
+namespace {
+// Address belongs to this driver, independent of process working directory.
+void ModuleAnchor() {}
+struct Handle {
+    HANDLE value = nullptr;
+    ~Handle() { if (value) CloseHandle(value); }
+    void imported() { value = nullptr; }
+};
+}
+
+bool PyroApi::Load() {
+    HMODULE driver = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            reinterpret_cast<LPCWSTR>(&ModuleAnchor), &driver)) return false;
+    wchar_t path[32768];
+    DWORD length = GetModuleFileNameW(driver, path, 32768);
+    if (!length || length >= 32768) return false;
+    std::wstring filename(path, length);
+    auto slash = filename.find_last_of(L"\\/");
+    if (slash == std::wstring::npos) return false;
+    filename.resize(slash + 1); filename += L"pyrowave-shared.dll";
+    module = LoadLibraryExW(filename.c_str(), nullptr, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+    if (!module) return false;
+#define LOAD(name) name = reinterpret_cast<decltype(name)>(GetProcAddress(module, #name)); if (!name) return false;
+    LOAD(pyrowave_create_device_by_compat)
+    LOAD(pyrowave_device_confirm_interop_support)
+    LOAD(pyrowave_device_destroy)
+    LOAD(pyrowave_image_create)
+    LOAD(pyrowave_image_get_image_view)
+    LOAD(pyrowave_image_destroy)
+    LOAD(pyrowave_encoder_create)
+    LOAD(pyrowave_encoder_destroy)
+    LOAD(pyrowave_encoder_encode_gpu_synchronous)
+    LOAD(pyrowave_encoder_compute_num_packets)
+    LOAD(pyrowave_encoder_packetize)
+    LOAD(pyrowave_sync_object_create)
+    LOAD(pyrowave_sync_object_get_semaphore)
+    LOAD(pyrowave_sync_object_cpu_wait)
+    LOAD(pyrowave_sync_object_destroy)
+#undef LOAD
+    return true;
+}
+
+extern "C" bool PyroWaveEncoderAvailable() {
+    static const bool supported = [] {
+        PyroApi api;
+        if (!api.Load()) return false;
+        pyrowave_device device = nullptr;
+        if (api.pyrowave_create_device_by_compat(0, 0, nullptr, nullptr, nullptr, &device) != PYROWAVE_SUCCESS) return false;
+        pyrowave_encoder encoder = nullptr;
+        pyrowave_encoder_create_info info = { device, 64, 64, PYROWAVE_CHROMA_SUBSAMPLING_444 };
+        bool ok = api.pyrowave_device_confirm_interop_support(device)
+            && api.pyrowave_encoder_create(&info, &encoder) == PYROWAVE_SUCCESS;
+        if (encoder) api.pyrowave_encoder_destroy(encoder);
+        api.pyrowave_device_destroy(device);
+        return ok;
+    }();
+    return supported;
+}
+
+VideoEncoderPyroWave::VideoEncoderPyroWave(std::shared_ptr<CD3DRender> r, int w, int h, ID3D11Texture2D* input[3])
+    : render(r), width(w), height(h) {
+    if (w < 64 || h < 64 || w > 8192 || h > 8192 || uint64_t(w) * h > 40000000)
+        throw MakeException("Unsupported PyroWave geometry");
+    for (int i = 0; i < 3; ++i) {
+        if (!input[i]) throw MakeException("PyroWave requires SDR planar textures");
+        planes[i] = input[i];
+    }
+}
+VideoEncoderPyroWave::~VideoEncoderPyroWave() { Shutdown(); }
+
+void VideoEncoderPyroWave::Initialize() {
+    if (!api.Load()) throw MakeException("PyroWave library unavailable; select AV1 or HEVC");
+    OK_OR_THROW(QUERY(render->GetDevice(), device.GetAddressOf()), L"PyroWave needs ID3D11Device5");
+    OK_OR_THROW(QUERY(render->GetContext(), context.GetAddressOf()), L"PyroWave needs ID3D11DeviceContext4");
+    Microsoft::WRL::ComPtr<IDXGIDevice> dxgi;
+    Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+    OK_OR_THROW(QUERY(render->GetDevice(), dxgi.GetAddressOf()), L"No DXGI device");
+    OK_OR_THROW(dxgi->GetAdapter(&adapter), L"No DXGI adapter");
+    DXGI_ADAPTER_DESC desc;
+    OK_OR_THROW(adapter->GetDesc(&desc), L"No adapter description");
+    static_assert(sizeof(LUID) == sizeof(pyrowave_luid));
+    PW(api.pyrowave_create_device_by_compat(0, 0, nullptr, nullptr,
+        reinterpret_cast<pyrowave_luid*>(&desc.AdapterLuid), &pyro));
+    if (!api.pyrowave_device_confirm_interop_support(pyro)) throw MakeException("PyroWave GPU interop unavailable");
+    for (int i = 0; i < 3; ++i) {
+        Microsoft::WRL::ComPtr<IDXGIResource1> resource;
+        OK_OR_THROW(QUERY(planes[i].Get(), resource.GetAddressOf()), L"Plane not shareable");
+        Handle handle;
+        OK_OR_THROW(resource->CreateSharedHandle(nullptr, GENERIC_ALL, nullptr, &handle.value), L"Plane handle failed");
+        VkImageCreateInfo image = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+        image.imageType = VK_IMAGE_TYPE_2D; image.extent = {uint32_t(width), uint32_t(height), 1};
+        image.mipLevels = 1; image.arrayLayers = 1; image.format = VK_FORMAT_R8_UNORM;
+        image.samples = VK_SAMPLE_COUNT_1_BIT; image.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        image.tiling = VK_IMAGE_TILING_OPTIMAL;
+        image.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        pyrowave_image_create_info info = {};
+        info.device = pyro; info.external_handle = reinterpret_cast<pyrowave_os_handle>(handle.value);
+        info.handle_type = VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D11_TEXTURE_BIT; info.image_create_info = &image;
+        PW(api.pyrowave_image_create(&info, &images[i]));
+        handle.imported(); // successful import consumes the NT handle
+        PW(api.pyrowave_image_get_image_view(images[i], VK_IMAGE_ASPECT_PLANE_0_BIT,
+            VK_IMAGE_USAGE_SAMPLED_BIT, &buffers.planes[i]));
+    }
+    pyrowave_encoder_create_info info = { pyro, width, height, PYROWAVE_CHROMA_SUBSAMPLING_444 };
+    PW(api.pyrowave_encoder_create(&info, &encoder));
+    OK_OR_THROW(device->CreateFence(0, D3D11_FENCE_FLAG_NONE, __uuidof(ID3D11Fence),
+        reinterpret_cast<void**>(renderFence.GetAddressOf())), L"Render fence failed");
+    OK_OR_THROW(device->CreateFence(0, D3D11_FENCE_FLAG_SHARED, __uuidof(ID3D11Fence),
+        reinterpret_cast<void**>(completeFence.GetAddressOf())), L"Completion fence failed");
+    Handle handle;
+    OK_OR_THROW(completeFence->CreateSharedHandle(nullptr, GENERIC_ALL, nullptr, &handle.value), L"Completion handle failed");
+    pyrowave_sync_object_create_info sync = {};
+    sync.device = pyro; sync.external_handle = reinterpret_cast<pyrowave_os_handle>(handle.value);
+    sync.handle_type = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_D3D12_FENCE_BIT;
+    sync.semaphore_type = VK_SEMAPHORE_TYPE_TIMELINE;
+    PW(api.pyrowave_sync_object_create(&sync, &completion));
+    handle.imported();
+    fenceEvent = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    if (!fenceEvent) throw MakeException("Render fence event failed");
+    bitstream.resize(8 * 1024 * 1024);
+    uint8_t config[10];
+    uint32_t w = width, h = height;
+    memcpy(config, &w, 4); memcpy(config + 4, &h, 4);
+    config[8] = 1; config[9] = Settings::Instance().m_useFullRangeEncoding ? 1 : 0;
+    SetVideoConfigNals(config, sizeof config, 3);
+    Info("PyroWave encoder ready: %dx%d 4:4:4 SDR", width, height);
+}
+
+void VideoEncoderPyroWave::Shutdown() {
+    if (pending) {
+        // GPU fault: don't free in-flight resources or wait forever inside SteamVR.
+        // Quarantine one failed instance until process exit, then use standard fallback.
+        api.module = nullptr;
+        for (auto &plane : planes) plane.Detach();
+        device.Detach(); context.Detach(); renderFence.Detach(); completeFence.Detach();
+        fenceEvent = nullptr; pyro = nullptr; encoder = nullptr; completion = nullptr;
+        for (auto &image : images) image = nullptr;
+        return;
+    }
+    if (encoder) { api.pyrowave_encoder_destroy(encoder); encoder = nullptr; }
+    for (auto &image : images) if (image) { api.pyrowave_image_destroy(image); image = nullptr; }
+    if (completion) { api.pyrowave_sync_object_destroy(completion); completion = nullptr; }
+    if (pyro) { api.pyrowave_device_destroy(pyro); pyro = nullptr; }
+    if (fenceEvent) { CloseHandle(fenceEvent); fenceEvent = nullptr; }
+}
+
+void VideoEncoderPyroWave::Transmit(ID3D11Texture2D*, uint64_t, uint64_t timestamp, bool) {
+    auto params = GetDynamicEncoderParams();
+    if (params.updated) { bitrate = uint64_t(params.bitrate_bps); fps = uint32_t(params.framerate); }
+    if (!bitrate || !fps) return;
+    pyrowave_rate_control rate = {};
+    rate.maximum_bitstream_size = size_t(std::clamp<uint64_t>(bitrate / 8 / fps, 1024, 4 * 1024 * 1024));
+    OK_OR_THROW(context->Signal(renderFence.Get(), ++fenceValue), L"Render fence signal failed");
+    render->GetContext()->Flush();
+    OK_OR_THROW(renderFence->SetEventOnCompletion(fenceValue, fenceEvent), L"Render wait failed");
+    if (WaitForSingleObject(fenceEvent, 1000) != WAIT_OBJECT_0) throw MakeException("Render GPU timed out");
+    pyrowave_gpu_external_reference refs[3] = {
+        {images[0], VK_QUEUE_FAMILY_EXTERNAL}, {images[1], VK_QUEUE_FAMILY_EXTERNAL}, {images[2], VK_QUEUE_FAMILY_EXTERNAL}
+    };
+    pyrowave_gpu_sync_operation acquire = {}, release = {};
+    acquire.images = refs; acquire.num_images = 3; release = acquire;
+    release.sync.semaphore = api.pyrowave_sync_object_get_semaphore(completion);
+    release.sync.value = fenceValue;
+    pending = true;
+    PW(api.pyrowave_encoder_encode_gpu_synchronous(encoder, &acquire, &release, &buffers, &rate));
+    // Signal follows the encoded-frame readback copy. Never enter packetizer's internal
+    // unbounded fence wait until this explicit one-second GPU completion succeeds.
+    PW(api.pyrowave_sync_object_cpu_wait(completion, fenceValue, 1000000000ull));
+    pending = false;
+    size_t count = 0;
+    PW(api.pyrowave_encoder_compute_num_packets(encoder, bitstream.size(), &count));
+    if (count != 1) throw MakeException("PyroWave frame packet exceeds transport limit");
+    pyrowave_packet packet = {};
+    size_t output = 0;
+    PW(api.pyrowave_encoder_packetize(encoder, &packet, bitstream.size(), &output, bitstream.data(), bitstream.size()));
+    if (output != 1 || packet.offset > bitstream.size() || packet.size > bitstream.size() - packet.offset)
+        throw MakeException("Invalid PyroWave packet bounds");
+    VideoSend(timestamp, bitstream.data() + packet.offset, int(packet.size), true);
+}
diff --git a/alvr/server_openvr/cpp/platform/win32/VideoEncoderPyroWave.h b/alvr/server_openvr/cpp/platform/win32/VideoEncoderPyroWave.h
