+pub fn is_usable_location(location_flags: SpaceLocationFlags) -> bool {
+    location_flags.contains(
+        SpaceLocationFlags::POSITION_VALID | SpaceLocationFlags::ORIENTATION_VALID,
+    )
+}
+
+/// Velocity is only forwarded when the matching flag is set and the values are finite.
+fn valid_velocity(
+    flags: xr::SpaceVelocityFlags,
+    bit: xr::SpaceVelocityFlags,
+    velocity: Vec3,
+) -> Vec3 {
+    if flags.contains(bit) && velocity.is_finite() {
+        velocity
+    } else {
+        Vec3::ZERO
+    }
+}
+
+/// Unit-normalized rotation, refusing zero-length and non-finite quaternions: normalizing those
+/// would produce a rotation that is not a rotation.
+pub fn normalized_quat(quat: Quat) -> Option<Quat> {
+    if !(quat.x.is_finite() && quat.y.is_finite() && quat.z.is_finite() && quat.w.is_finite()) {
+        return None;
+    }
+
+    let length = quat.length();
+    if !length.is_finite() || length <= f32::EPSILON {
+        return None;
+    }
+
+    Some(Quat::from_xyzw(
+        quat.x / length,
+        quat.y / length,
+        quat.z / length,
+        quat.w / length,
+    ))
+}
+
+/// A pose is converted only when it is completely finite and carries a non-degenerate rotation.
+pub fn validated_pose(pose: Pose) -> Option<Pose> {
+    if !pose.position.is_finite() {
+        return None;
+    }
+
+    Some(Pose {
+        position: pose.position,
+        orientation: normalized_quat(pose.orientation)?,
+    })
+}
+
+const HAND_JOINT_COUNT: usize = 26;
+
+/// All the joints of a hand skeleton must be currently valid and finite, otherwise nothing is sent:
+/// a partially filled skeleton animates stale fingers.
+pub fn validated_hand_skeleton(joint_locations: &[xr::HandJointLocation]) -> Option<[Pose; 26]> {
+    if joint_locations.len() != HAND_JOINT_COUNT {
+        return None;
+    }
+
+    let mut joints: [Pose; HAND_JOINT_COUNT] = [Pose::default(); HAND_JOINT_COUNT];
+
+    for (joint, out) in joint_locations.iter().zip(joints.iter_mut()) {
+        if !is_usable_location(joint.location_flags) {
+            return None;
+        }
+
+        *out = validated_pose(crate::from_xr_pose(joint.pose))?;
+    }
+
+    Some(joints)
+}
+
+/// The velocity of a device between its current pose and its pose at a later time, derived from the
+/// two poses because some runtimes report velocities in the wrong frame of reference.
+///
+/// Both poses are validated, so a partially valid sample never produces a velocity. A zero relative
+/// rotation yields a zero angular velocity: `to_scaled_axis()` reports a zero vector for it, so no
+/// motion threshold is needed and a legitimate slow rotation is never dropped.
+fn pose_delta_velocity(current: Pose, future: Pose, time_offset_s: f32) -> Option<(Vec3, Vec3)> {
+    if !time_offset_s.is_finite() || time_offset_s <= 0.0 {
+        return None;
+    }
+
+    let current = validated_pose(current)?;
+    let future = validated_pose(future)?;
+
+    let linear = (future.position - current.position) / time_offset_s;
+    // The relative rotation is validated like any other rotation: a degenerate or non-finite
+    // quaternion has no axis.
+    let rotation = normalized_quat(future.orientation * current.orientation.inverse())?;
+    let angular = rotation.to_scaled_axis() / time_offset_s;
+
+    if !linear.is_finite() || !angular.is_finite() {
+        return None;
+    }
+
+    Some((linear, angular))
+}
+
+/// Some headsets use wrong frame of reference for linear and angular velocities, so for those the
+/// velocities are derived from the future pose. The derived values are used only when the future
+/// pose is valid and the result is finite.
+fn future_pose_velocity(
+    grip_space: &xr::Space,
+    reference_space: &xr::Space,
+    time: Duration,
+    future_time: Duration,
+    current: Pose,
+) -> Option<(Vec3, Vec3)> {
+    let future_location = grip_space
+        .locate(reference_space, crate::to_xr_time(future_time))
+        .ok()?;
+
+    if !is_usable_location(future_location.location_flags) {
+        return None;
+    }
+
+    pose_delta_velocity(
+        current,
+        crate::from_xr_pose(future_location.pose),
+        future_time.saturating_sub(time).as_secs_f32(),
+    )
+}
