+    #[test]
+    fn a_newer_dashboard_write_invalidates_the_settings_snapshot() {
+        let session = SessionConfig::default();
+        let at_prepare = serde_json::to_value(session.to_settings()).unwrap();
+        let same = serde_json::to_value(session.to_settings()).unwrap();
+        assert!(settings_snapshot_unchanged(&at_prepare, Ok(same)));
+
+        // A setting the dashboard changed while the helper preflighted.
+        let mut newer_settings = session.to_settings();
+        newer_settings.video.preferred_fps = 111.0;
+        let newer = serde_json::to_value(newer_settings).unwrap();
+        assert!(!settings_snapshot_unchanged(&at_prepare, Ok(newer)));
+
+        // A snapshot that cannot be read back is no proof at all, so it fails closed.
+        let unreadable: serde_json::Result<serde_json::Value> =
+            Err(serde_json::from_str::<serde_json::Value>("{").unwrap_err());
+        assert!(!settings_snapshot_unchanged(&at_prepare, unreadable));
+    }
+
