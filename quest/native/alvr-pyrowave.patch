+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn marker() -> ServerControlPacket {
+        ServerControlPacket::Reserved(RESTART_PREPARING_MARKER.into())
+    }
+
+    #[test]
+    fn a_normal_connect_is_decided_within_the_handshake_timeout() {
+        let start = Instant::now();
+        let handshake = ServerHandshake::new(false, start);
+
+        assert_eq!(handshake.remaining(start), HANDSHAKE_ACTION_TIMEOUT);
+        assert_eq!(
+            handshake.remaining(start + HANDSHAKE_ACTION_TIMEOUT - Duration::from_millis(1)),
+            Duration::from_millis(1)
+        );
+        assert!(!handshake.is_expired(
+            start + HANDSHAKE_ACTION_TIMEOUT - Duration::from_millis(1)
+        ));
+        assert!(handshake.is_expired(start + HANDSHAKE_ACTION_TIMEOUT));
+        // The wait never grows for a connection that cannot restart SteamVR.
+        assert_eq!(handshake.remaining(start + RESTART_PREPARING_TIMEOUT), Duration::ZERO);
+    }
+
+    #[test]
+    fn start_stream_is_accepted_with_and_without_a_permission() {
+        let start = Instant::now();
+
+        for restart_permitted in [false, true] {
+            let mut handshake = ServerHandshake::new(restart_permitted, start);
+
+            assert_eq!(
+                handshake.on_packet(&ServerControlPacket::StartStream, start),
+                HandshakeStep::Done(HandshakeOutcome::StartStream)
+            );
+        }
+    }
+
+    #[test]
+    fn an_authorized_marker_opens_one_longer_window() {
+        let start = Instant::now();
+        let mut handshake = ServerHandshake::new(true, start);
+        let marked_at = start + Duration::from_millis(1500);
+
+        assert_eq!(
+            handshake.on_packet(&marker(), marked_at),
+            HandshakeStep::KeepWaiting { preparing: true }
+        );
+        // The preparation is announced before the slow part, so the window covers the whole worker
+        // preflight and restart.
+        assert!(handshake.deadline > marked_at + Duration::from_secs(10));
+        // The permission is spent by the marker, so the user is asked only once.
+        assert!(handshake.permission_spent);
+        assert!(!handshake.accepts_marker());
+    }
+
+    #[test]
+    fn a_repeated_marker_never_extends_the_window() {
+        let start = Instant::now();
+        let mut handshake = ServerHandshake::new(true, start);
+        let marked_at = start + Duration::from_millis(100);
+        let deadline = marked_at + RESTART_PREPARING_TIMEOUT;
+
+        assert_eq!(
+            handshake.on_packet(&marker(), marked_at),
+            HandshakeStep::KeepWaiting { preparing: true }
+        );
+
+        // However many markers arrive, the wait is bounded by the first one.
+        for second in 1_u64..16 {
+            let at = marked_at + Duration::from_secs(second);
+
+            assert_eq!(
+                handshake.on_packet(&marker(), at),
+                HandshakeStep::KeepWaiting { preparing: false }
+            );
+            assert_eq!(handshake.deadline, deadline);
+        }
+
+        assert!(!handshake.is_expired(deadline - Duration::from_millis(1)));
+        assert!(handshake.is_expired(deadline));
+    }
+
+    #[test]
+    fn a_marker_for_an_unauthorized_attempt_is_refused() {
+        let start = Instant::now();
+
+        // This handshake never advertised a permission, e.g. because the consent was already spent
+        // by a previous connection.
+        let mut never_authorized = ServerHandshake::new(false, start);
+        assert!(never_authorized.permission_spent);
+
+        assert_eq!(
+            never_authorized.on_packet(&marker(), start),
+            HandshakeStep::Done(HandshakeOutcome::Unexpected)
+        );
+        // and it did not buy any extra waiting.
+        assert_eq!(never_authorized.deadline, start + HANDSHAKE_ACTION_TIMEOUT);
+
+        // The same after a legacy Restarting spent the permission.
+        let mut spent = ServerHandshake::new(true, start);
+        assert_eq!(
+            spent.on_packet(&ServerControlPacket::Restarting, start),
+            HandshakeStep::Done(HandshakeOutcome::Restarting)
+        );
+        assert!(spent.permission_spent);
+        assert_eq!(
+            spent.on_packet(&marker(), start),
+            HandshakeStep::Done(HandshakeOutcome::Unexpected)
+        );
+    }
+
+    #[test]
+    fn a_legacy_restarting_is_accepted_and_spends_the_permission() {
+        let start = Instant::now();
+        let mut handshake = ServerHandshake::new(true, start);
+
+        assert_eq!(
+            handshake.on_packet(&ServerControlPacket::Restarting, start),
+            HandshakeStep::Done(HandshakeOutcome::Restarting)
+        );
+        assert!(handshake.permission_spent);
+    }
+
+    #[test]
+    fn the_final_outcome_is_accepted_inside_the_preparing_window() {
+        let start = Instant::now();
+        let marked_at = start + Duration::from_millis(100);
+
+        for (packet, expected) in [
+            (
+                ServerControlPacket::Restarting,
+                HandshakeOutcome::Restarting,
+            ),
+            (
+                ServerControlPacket::Reserved(RESTART_FAILED_REASON.into()),
+                HandshakeOutcome::Issue("restart_failed"),
+            ),
+            (
+                ServerControlPacket::Reserved(RESTART_CONSENT_REQUIRED_REASON.into()),
+                HandshakeOutcome::Issue("restart_required"),
+            ),
+        ] {
+            let mut handshake = ServerHandshake::new(true, start);
+            assert_eq!(
+                handshake.on_packet(&marker(), marked_at),
+                HandshakeStep::KeepWaiting { preparing: true }
+            );
+
+            assert_eq!(
+                handshake.on_packet(
+                    &packet,
+                    marked_at + RESTART_PREPARING_TIMEOUT - Duration::from_millis(1)
+                ),
+                HandshakeStep::Done(expected)
+            );
+        }
+    }
+
+    #[test]
+    fn the_two_failure_codes_map_to_distinct_messages() {
+        let required = connection_issue_message("restart_required");
+        let failed = connection_issue_message("restart_failed");
+
+        assert_ne!(required, failed);
+        assert!(!required.is_empty() && !failed.is_empty());
+        // An unknown code never claims a restart problem.
+        assert_eq!(
+            connection_issue_message("anything else"),
+            "Streaming issue. Check the PC for more details."
+        );
+    }
+
+    #[test]
+    fn the_recovery_window_covers_the_steamvr_exit_and_startup() {
+        // SteamVR takes up to 45s to exit and up to 30s to start again, and the streamer answers
+        // nobody for that whole time.
+        assert!(RESTART_RECOVERY_TIMEOUT >= Duration::from_secs(45) + Duration::from_secs(30));
+    }
+
+    #[test]
+    fn the_window_opens_once_and_is_never_extended() {
+        let start = Instant::now();
+        let deadline = start + RESTART_RECOVERY_TIMEOUT;
+        let ctx = ConnectionContext::default();
+
+        ctx.start_restart_recovery(start);
+
+        // A repeated marker, or a reconnect claiming the same restart again, buys no extra time.
+        for second in 1_u64..16 {
+            ctx.start_restart_recovery(start + Duration::from_secs(second));
+
+            assert_eq!(*ctx.restart_recovery_deadline.lock(), Some(deadline));
+        }
+    }
+
+    #[test]
+    fn the_window_is_bounded_and_a_timeout_is_reported_once() {
+        let start = Instant::now();
+        let deadline = start + RESTART_RECOVERY_TIMEOUT;
+        let ctx = ConnectionContext::default();
+        ctx.start_restart_recovery(start);
+
+        assert!(!ctx.take_expired_restart_recovery(deadline - Duration::from_millis(1)));
+        // The timeout consumes the window, so the same failure is never reported twice.
+        assert!(ctx.take_expired_restart_recovery(deadline));
+        assert!(!ctx.take_expired_restart_recovery(deadline + Duration::from_secs(1)));
+    }
+
+    #[test]
+    fn only_a_stream_closes_the_window() {
+        let start = Instant::now();
+        let deadline = start + RESTART_RECOVERY_TIMEOUT;
+        let ctx = ConnectionContext::default();
+        ctx.start_restart_recovery(start);
+
+        // A configuration packet only proves the streamer accepted the connection, so the window is
+        // still open: a streamer that answers once and then disappears is caught as well.
+        assert!(!ctx.take_expired_restart_recovery(start + Duration::from_secs(1)));
+
+        ctx.clear_restart_recovery();
+
+        assert!(!ctx.take_expired_restart_recovery(deadline));
+    }
+
+    #[test]
+    fn a_closed_window_does_not_give_the_consent_back() {
+        let start = Instant::now();
+        let ctx = ConnectionContext::default();
+        ctx.restart_consumed.set(true);
+        ctx.start_restart_recovery(start);
+
+        ctx.clear_restart_recovery();
+
+        // Closing the window is not a consent reset: the next connection has to ask the user again.
+        assert!(ctx.restart_consumed.value());
+    }
+
+    #[test]
+    fn a_connection_without_a_restart_attempt_waits_as_before() {
+        let ctx = ConnectionContext::default();
+
+        // The ordinary search for the streamer is unbounded, as it always was: no window is open, so
+        // nothing times out.
+        assert!(!ctx.take_expired_restart_recovery(
+            Instant::now() + Duration::from_secs(24 * 60 * 60)
+        ));
+    }
+}
