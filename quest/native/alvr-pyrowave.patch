+/// The parts of `OpenvrConfig` that are negotiated with the client for a stream. They are the only
+/// ones that must be preserved verbatim when the static settings are rebuilt, because they are the
+/// values the driver is actually running with.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct NegotiatedOpenvrFields {
+    pub codec: u8,
+    pub eye_resolution_width: u32,
+    pub eye_resolution_height: u32,
+    pub target_eye_resolution_width: u32,
+    pub target_eye_resolution_height: u32,
+    pub refresh_rate: u32,
+    pub enable_foveated_encoding: bool,
+    pub h264_profile: u32,
+    pub use_10bit_encoder: bool,
+    pub use_full_range_encoding: bool,
+    pub enable_hdr: bool,
+    pub encoding_gamma: f32,
+}
+
+impl NegotiatedOpenvrFields {
+    pub fn apply(self, config: &mut OpenvrConfig) {
+        config.eye_resolution_width = self.eye_resolution_width;
+        config.eye_resolution_height = self.eye_resolution_height;
+        config.target_eye_resolution_width = self.target_eye_resolution_width;
+        config.target_eye_resolution_height = self.target_eye_resolution_height;
+        config.refresh_rate = self.refresh_rate;
+        config.enable_foveated_encoding = self.enable_foveated_encoding;
+        config.h264_profile = self.h264_profile;
+        config.use_10bit_encoder = self.use_10bit_encoder;
+        config.use_full_range_encoding = self.use_full_range_encoding;
+        config.enable_hdr = self.enable_hdr;
+        config.encoding_gamma = self.encoding_gamma;
+        config.codec = self.codec;
+    }
+}
+
+/// The config the shutdown path writes to disk: the static settings rebuilt from the dashboard, with
+/// the fields that were actually negotiated on top of them.
+///
+/// `negotiated` is None when no stream ever started, so a refused request or a failed restart
+/// preparation can never change what the next SteamVR boot reads.
+pub fn config_for_next_boot(
+    session: &SessionConfig,
+    negotiated: Option<&NegotiatedOpenvrFields>,
+) -> OpenvrConfig {
+    let mut config = contruct_openvr_config(session);
+
+    if let Some(fields) = negotiated {
+        fields.apply(&mut config);
+    }
+
+    config
+}
+
+/// What the handshake may do with the negotiated config. Streaming is allowed only when the config
+/// is exactly the one the driver booted with: a session.json that already holds the desired config
+/// (a previous handshake or shutdown) says nothing about the running SteamVR instance.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum StreamAction {
+    Start,
+    ConsentRequired,
+    Restart,
+}
+
+pub fn boot_config_matches(
+    boot_config: Option<&OpenvrConfig>,
+    negotiated_config: &OpenvrConfig,
+) -> bool {
+    boot_config.is_some_and(|boot| boot == negotiated_config)
+}
+
+pub fn decide_stream_action(boot_matches: bool, client_allows_restart: bool) -> StreamAction {
+    if boot_matches {
+        StreamAction::Start
+    } else if client_allows_restart {
+        StreamAction::Restart
+    } else {
+        StreamAction::ConsentRequired
+    }
