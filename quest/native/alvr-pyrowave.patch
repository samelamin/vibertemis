diff --git a/alvr/client_core/src/video_decoder/pyrowave.rs b/alvr/client_core/src/video_decoder/pyrowave.rs
new file mode 100644
index 0000000..f77e180
--- /dev/null
+++ b/alvr/client_core/src/video_decoder/pyrowave.rs
@@ -0,0 +1,212 @@
+//! Intra-only latest-frame decoder. A decoded AHardwareBuffer stays leased until
+//! the renderer's NEXT dequeue (the same lifetime contract as MediaCodec).
+use super::{parse_pyrowave_config, VideoDecoderConfig};
+use alvr_common::{
+    anyhow::{anyhow, bail, Result},
+    parking_lot::{Condvar, Mutex},
+};
+use std::{
+    ffi::c_void,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc, OnceLock,
+    },
+    thread::{self, JoinHandle},
+    time::Duration,
+};
+
+static FAILED: AtomicBool = AtomicBool::new(false);
+static PROBED: OnceLock<bool> = OnceLock::new();
+#[repr(C)]
+#[derive(Default)]
+struct FrameInfo {
+    decode_ms: f64,
+    convert_ms: f64,
+    total_ms: f64,
+    complete: i32,
+}
+extern "C" {
+    fn pyroclient_probe() -> i32;
+    fn pyroclient_create(w: u32, h: u32, chroma: i32, full: i32, ring: u32) -> *mut c_void;
+    fn pyroclient_push_packet(c: *mut c_void, data: *const u8, size: usize) -> i32;
+    fn pyroclient_decode(c: *mut c_void, out: *mut *mut c_void, info: *mut FrameInfo) -> i32;
+    fn pyroclient_clear(c: *mut c_void);
+    fn pyroclient_release(c: *mut c_void, out: *mut c_void);
+    fn pyroclient_destroy(c: *mut c_void);
+}
+
+pub fn disable() {
+    FAILED.store(true, Ordering::Release);
+}
+
+pub fn supported() -> bool {
+    !FAILED.load(Ordering::Acquire) && *PROBED.get_or_init(|| unsafe { pyroclient_probe() == 1 })
+}
+
+struct Pending {
+    frame: Mutex<Option<(Duration, Vec<u8>)>>,
+    ready: Condvar,
+    running: AtomicBool,
+}
+struct Frames {
+    decoded: Option<(Duration, usize)>,
+    in_use: Option<usize>,
+}
+struct Decoder {
+    ptr: usize,
+    frames: Mutex<Frames>,
+}
+// Only the worker performs decode/queue operations. Release merely takes the
+// bridge's lease mutex. Drop runs after the worker joins and renderer releases.
+impl Decoder {
+    fn ptr(&self) -> *mut c_void {
+        self.ptr as *mut c_void
+    }
+    fn release(&self, ptr: usize) {
+        unsafe { pyroclient_release(self.ptr(), ptr as *mut c_void) }
+    }
+}
+impl Drop for Decoder {
+    fn drop(&mut self) {
+        unsafe { pyroclient_destroy(self.ptr()) }
+    }
+}
+
+pub struct VideoDecoderSink {
+    pending: Arc<Pending>,
+}
+impl VideoDecoderSink {
+    pub fn push_frame_nal(&mut self, timestamp: Duration, data: &[u8]) -> Result<bool> {
+        if data.is_empty() || data.len() > 8 * 1024 * 1024 {
+            bail!("PyroWave frame exceeds limit");
+        }
+        let mut slot = self.pending.frame.lock();
+        if !self.pending.running.load(Ordering::Acquire) {
+            return Ok(false);
+        }
+        *slot = Some((timestamp, data.to_vec()));
+        self.pending.ready.notify_one();
+        Ok(true)
+    }
+}
+pub struct VideoDecoderSource {
+    pending: Arc<Pending>,
+    decoder: Arc<Decoder>,
+    thread: Option<JoinHandle<()>>,
+}
+impl VideoDecoderSource {
+    pub fn dequeue_frame(&mut self) -> Option<(Duration, *mut c_void)> {
+        let mut frames = self.decoder.frames.lock();
+        let (timestamp, ptr) = frames.decoded.take()?;
+        if let Some(previous) = frames.in_use.replace(ptr) {
+            self.decoder.release(previous);
+        }
+        Some((timestamp, ptr as *mut c_void))
+    }
+}
+impl Drop for VideoDecoderSource {
+    fn drop(&mut self) {
+        {
+            let mut pending = self.pending.frame.lock();
+            self.pending.running.store(false, Ordering::Release);
+            *pending = None;
+            self.pending.ready.notify_all();
+        }
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+        let mut frames = self.decoder.frames.lock();
+        if let Some(ptr) = frames.in_use.take() {
+            self.decoder.release(ptr);
+        }
+        if let Some((_, ptr)) = frames.decoded.take() {
+            self.decoder.release(ptr);
+        }
+    }
+}
+
+pub fn video_decoder_split(
+    config: VideoDecoderConfig,
+    report: impl Fn(Result<Duration>) + Send + Sync + 'static,
+) -> Result<(VideoDecoderSink, VideoDecoderSource)> {
+    let cfg = parse_pyrowave_config(&config.config_buffer)?;
+    if !supported() {
+        bail!("PyroWave unavailable; reconnect using the standard codec");
+    }
+    let ptr = unsafe { pyroclient_create(cfg.width, cfg.height, 1, cfg.full_range as i32, 3) };
+    if ptr.is_null() {
+        FAILED.store(true, Ordering::Release);
+        bail!("PyroWave initialization failed; reconnecting with the standard codec");
+    }
+    let decoder = Arc::new(Decoder {
+        ptr: ptr as usize,
+        frames: Mutex::new(Frames {
+            decoded: None,
+            in_use: None,
+        }),
+    });
+    let pending = Arc::new(Pending {
+        frame: Mutex::new(None),
+        ready: Condvar::new(),
+        running: AtomicBool::new(true),
+    });
+    let thread = thread::Builder::new()
+        .name("PyroWave decoder".into())
+        .spawn({
+            let decoder = Arc::clone(&decoder);
+            let pending = Arc::clone(&pending);
+            move || {
+                while pending.running.load(Ordering::Acquire) {
+                    let next = {
+                        let mut slot = pending.frame.lock();
+                        while slot.is_none() && pending.running.load(Ordering::Acquire) {
+                            pending.ready.wait(&mut slot);
+                        }
+                        slot.take()
+                    };
+                    let Some((timestamp, data)) = next else {
+                        continue;
+                    };
+                    let mut out = std::ptr::null_mut();
+                    let mut info = FrameInfo::default();
+                    let result = unsafe {
+                        // ALVR delivers an assembled intra frame, never mix partial frames.
+                        pyroclient_clear(decoder.ptr());
+                        if pyroclient_push_packet(decoder.ptr(), data.as_ptr(), data.len()) != 1 {
+                            -1
+                        } else {
+                            pyroclient_decode(decoder.ptr(), &mut out, &mut info)
+                        }
+                    };
+                    if result == 1 {
+                        continue;
+                    } // all output slots leased: drop without blocking receive
+                    if result != 0 || out.is_null() || info.complete != 1 {
+                        FAILED.store(true, Ordering::Release);
+                        pending.running.store(false, Ordering::Release);
+                        report(Err(anyhow!(
+                            "PyroWave decoding failed; reconnecting with the standard codec"
+                        )));
+                        break;
+                    }
+                    {
+                        let mut frames = decoder.frames.lock();
+                        if let Some((_, old)) = frames.decoded.replace((timestamp, out as usize)) {
+                            decoder.release(old);
+                        }
+                    }
+                    report(Ok(timestamp));
+                }
+            }
+        })?;
+    Ok((
+        VideoDecoderSink {
+            pending: Arc::clone(&pending),
+        },
+        VideoDecoderSource {
+            pending,
+            decoder,
+            thread: Some(thread),
+        },
+    ))
+}
diff --git a/alvr/client_core/src/video_decoder/pyrowave_config.rs b/alvr/client_core/src/video_decoder/pyrowave_config.rs
new file mode 100644
index 0000000..b46ad02
--- /dev/null
+++ b/alvr/client_core/src/video_decoder/pyrowave_config.rs
@@ -0,0 +1,72 @@
+use alvr_common::anyhow::{bail, Result};
+
+#[derive(Debug, PartialEq)]
+pub struct PyroWaveConfig {
+    pub width: u32,
+    pub height: u32,
+    pub full_range: bool,
+}
+
+// Custom protocol v1: LE u32 width/height, 4:4:4 flag, full-range flag.
+// Validate before any allocation or native call. Only upstream CDF 9/7 is supported.
+pub fn parse_pyrowave_config(bytes: &[u8]) -> Result<PyroWaveConfig> {
+    if bytes.len() != 10 {
+        bail!("Invalid PyroWave config length");
+    }
+    let width = u32::from_le_bytes(bytes[0..4].try_into()?);
+    let height = u32::from_le_bytes(bytes[4..8].try_into()?);
+    if !(64..=8192).contains(&width)
+        || !(64..=8192).contains(&height)
+        || u64::from(width) * u64::from(height) > 40_000_000
+        || bytes[8] != 1
+        || bytes[9] > 1
+    {
+        bail!("Unsupported PyroWave geometry or pixel format");
+    }
+    Ok(PyroWaveConfig {
+        width,
+        height,
+        full_range: bytes[9] == 1,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn config(w: u32, h: u32) -> Vec<u8> {
+        [
+            w.to_le_bytes().as_slice(),
+            h.to_le_bytes().as_slice(),
+            &[1, 1],
+        ]
+        .concat()
+    }
+    #[test]
+    fn validates_before_native_allocation() {
+        assert_eq!(
+            parse_pyrowave_config(&config(4096, 2048)).unwrap().width,
+            4096
+        );
+        for (w, h) in [
+            (0, 1),
+            (63, 256),
+            (8193, 1024),
+            (8192, 8192),
+            (u32::MAX, u32::MAX),
+        ] {
+            assert!(parse_pyrowave_config(&config(w, h)).is_err());
+        }
+        let mut data = config(4096, 2048);
+        for len in 0..10 {
+            assert!(parse_pyrowave_config(&data[..len]).is_err());
+        }
+        data.push(0);
+        assert!(parse_pyrowave_config(&data).is_err());
+        data.pop();
+        data[8] = 0;
+        assert!(parse_pyrowave_config(&data).is_err());
+        data[8] = 1;
+        data[9] = 2;
+        assert!(parse_pyrowave_config(&data).is_err());
+    }
+}
