+/// `Settings` derives `Serialize` but not `PartialEq`, so the settings a restart was decided from
+/// are compared as the JSON they serialize to.
+///
+/// A snapshot that cannot be read back proves nothing, so it counts as changed: nothing is ever
+/// written over settings this handshake never saw. Only the settings are fingerprinted, because the
+/// rest of the session holds the statistics and the client states, which change on their own and
+/// would invalidate the restart for no reason.
+pub fn settings_snapshot_unchanged(
+    at_prepare: &serde_json::Value,
+    now: serde_json::Result<serde_json::Value>,
+) -> bool {
+    now.is_ok_and(|now| at_prepare == &now)
+}
+
+pub fn snapshot_lifecycle(state: &LifecycleState) -> LifecycleState {
+    match state {
+        LifecycleState::StartingUp => LifecycleState::StartingUp,
+        LifecycleState::Idle => LifecycleState::Idle,
+        LifecycleState::Resumed => LifecycleState::Resumed,
+        LifecycleState::ShuttingDown => LifecycleState::ShuttingDown,
+    }
+}
+
+/// Whether the state a SteamVR restart was decided from survived the worker preflight.
+///
+/// Every condition is required: the settings and the pending config are the ones the desired config
+/// was built from, the session must still be the resumed one it was, and the client that gave the
+/// consent must still be there. Anything that could not be revalidated counts as changed, so a
+/// restart that cannot prove the session is unchanged fails closed: it persists nothing and leaves
+/// the running SteamVR alone.
+pub fn restart_preconditions_hold(
+    settings_unchanged: bool,
+    pending_config_unchanged: bool,
+    lifecycle_unchanged: bool,
+    lifecycle: LifecycleState,
+    client_still_eligible: bool,
+) -> bool {
+    settings_unchanged
+        && pending_config_unchanged
+        && lifecycle_unchanged
+        && lifecycle == LifecycleState::Resumed
+        && client_still_eligible
+}
