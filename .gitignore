# Qt build artifacts
Makefile*
*.o
*.a
*.app/
.qmake.cache
.qmake.stash
moc_*.cpp
moc_*.h
*.moc
qrc_*.cpp
ui_*.h
*.pro.user*
# Test artifacts only - keep source files visible. The negation rules below
# re-include tst_*.cpp and tst_*.h so future test sources are not hidden.
tests/**/tst_*
!tests/**/tst_*.cpp
!tests/**/tst_*.h
tests/**/moc_predefs.h
tests/**/target_wrapper.sh

# Build directories
build/
release/
debug/

# Platform specific
*.dmg
*.exe
*.deb
*.rpm
*.AppImage
*.zip
*.tar.gz

# Qt Creator
*.pro.user
*.autosave

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
*.dSYM/

# Windows
Thumbs.db
*.pdb

# Logs
*.log

# Dependencies
node_modules/

# Local secrets / per-developer environment files (e.g. Cloudflare Worker
# secrets for Wave 4's services/crash-endpoint, read by `wrangler dev`).
.env
.dev.vars

# Generated QML cache
*qmlcache*

# Config tests
config.tests/*/.qmake.stash
config.tests/*/Makefile

# Visual Studio
**/.vs/
*.a
*.o
config.log
Makefile*
release/
debug/
h264bitstream/h264bitstream
moonlight-common-c/moonlight-common-c
*.a
config.log
**/qml_qmlcache.qrc
*.a
config.log
**/qml_qmlcache.qrc

# Quest3 VR preview (quest/) — build-only artefacts and secrets.
# The generated build tree is build/quest/ (ignored above). quest/build/
# contains tracked recipes (the *.sh helpers) that an archive user runs
# to rebuild from source. The negation rules below re-include
# quest/build/*.sh and quest/tests/* while keeping all generated build
# output (build/quest/upstream/, alvr_client_android_*.apk, .gradle
# caches, etc.) ignored.
quest/build/*
!quest/build/*.sh
!quest/build/*.sh.in
!quest/build/
quest/dist/
*.keystore
keystore.properties
quest/keystore.properties
